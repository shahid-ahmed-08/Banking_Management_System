# =============================================================
#  Shahid National Bank — .gitignore
#  Only source code, docs, configs, and scripts are tracked.
# =============================================================

# ── Compiled & build outputs ──────────────────────────────────
build/
target/
*.class
*.jar
!lib/**/*.jar

# ── Runtime data & logs ───────────────────────────────────────
*.ser
*.log
*.properties
transaction_log.txt
banking_state.properties
banking-migrations.properties
banking-state-readme.txt
backups/

# ── IDE / Editor artifacts ────────────────────────────────────
.idea/
*.iml
.vscode/
*.swp
*.swo
*.DS_Store

# ── OS noise ──────────────────────────────────────────────────
Thumbs.db
desktop.ini

# ── Temporary / scratch ───────────────────────────────────────
temp.md
scratch/

# ── Maven wrapper cache (keep wrapper scripts, ignore downloads)
.maven/repository/
